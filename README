Create Nginx Config
sudo nano /etc/nginx/sites-available/mycrm
Paste this:

server {
    listen 80;
    server_name YOUR_SERVER_IP;

    location = /favicon.ico { access_log off; log_not_found off; }

    location /static/ {
        root /root/My_CRM;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/root/My_CRM/gunicorn.sock;
    }
}


Enable the Site
